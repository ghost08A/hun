{
  "name": "price-alert",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate:local": "wrangler d1 migrations apply price-alert --local",
    "migrate:remote": "wrangler d1 migrations apply price-alert --remote",
    "assets": "node scripts/assets.mjs",
    "fetch": "node scripts/fetch.mjs",
    "backup": "node scripts/backup.mjs",
    "credits": "node scripts/credits.mjs",
    "notify": "node scripts/notify.mjs send",
    "dev:worker": "wrangler dev --test-scheduled",
    "line-test": "node scripts/notify.mjs test",
    "test": "node --test src/core.test.mjs src/market.test.mjs src/reference.test.mjs src/alerts.test.mjs src/line.test.mjs src/daily.test.mjs src/chat.test.mjs src/webhook.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
