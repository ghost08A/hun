name = "price-alert"
compatibility_date = "2026-11-01"

main = "src/worker.mjs"

# 19:00 and 20:00 Asia/Bangkok (UTC+7, no DST). Cron runs in UTC. Nothing runs until `wrangler deploy` (Phase 7).
[triggers]
crons = ["0 12 * * *", "0 13 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "price-alert"
# Fill in after `npx wrangler d1 create price-alert` (not a secret).
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"